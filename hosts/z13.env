# =============================================================================
# hosts/z13.env — Z13-specific tuning (SOW §A.3 host-neutrality)
# Provisioning a different host = replacing this ONE file. Everything else is
# host-neutral. Values measured/amended at M1 (§I.5) are marked [MEASURE].
# =============================================================================

# --- Platform ---
HOST_MODEL="ASUS ROG Flow Z13 GZ302EA (AMD Ryzen AI MAX+ 395 / Strix Halo)"
GPU="Radeon 8060S (gfx1151)"
BACKEND="vulkan"          # §D.5: Mesa RADV is the binding path; ROCm is alt only
LINUX_KERNEL="6.17.0-1030-oem"

# --- Memory split (§D.5 / Rev 6.1) [VERIFIED 2026-08-02] ---
# amdgpu mem_info_vram_total = 96 GiB GPU-visible; Linux sees ~30 GiB system.
# Sum = 128 GB LPDDR5X. BIOS VRAM reservation is small; GTT/TTM covers the rest.
GPU_VISIBLE_GB=96
SYSTEM_RAM_GB=32

# --- llama.cpp mandatory runtime flags (§D.5; acceptance conditions, not opts) ---
LLAMA_FLAGS_COMMON="--jinja -ub 512 -ctk q8_0 -ctv q8_0 -fa auto"
LLAMA_FLAGS_VULKAN="-ngl 999 -t 8"
# -fa auto is per-model verified; record the result per alias in manifests/models.yaml
# Speculative decoding is DISABLED for all binding figures (§I.1/§D.7).

# --- Power profiles (§I.5) ---
# Mechanism: asus-nb-wmi PPT sysfs + platform_profile + governor + cpupower max
# + charge threshold + fan curve. EPP exposes only "performance" on this kernel
# (cannot differentiate profiles), so governor + max-freq + PPT are used instead.
PPT_SYSFS="/sys/devices/platform/asus-nb-wmi"
PLATFORM_PROFILE="/sys/firmware/acpi/platform_profile"
CHARGE_THRESH="/sys/class/power_supply/BAT0/charge_control_end_threshold"

# [MEASURE @ M1] — ppt_pl1_spl read back "5" (anomalous); C validates the write
# actually caps the SMU before these numbers are trusted. If it does not bite,
# profiles are defined by mode + measured plateau wattage instead.
BATCH_PROFILE="performance"     # platform_profile + governor
BATCH_CPU_MAX_GHZ=5.1
BATCH_PPT_PL1_W=70              # [MEASURE] §I.3 says ~70 W sustained; confirm
BATCH_CHARGE_PCT=100

ECO_PROFILE="quiet"             # platform_profile (powersave governor forced)
ECO_CPU_MAX_GHZ=3.0
ECO_PPT_PL1_W=28                # [MEASURE] target floor for eco-longevity
ECO_CHARGE_PCT=80

# --- Sensors (units confirmed 2026-08-02) ---
S_AMDGPU_POWER="/sys/class/hwmon/hwmon11/power1_average"   # microWatts -> /1e6 = W (PPT)
S_AMDGPU_TEMP="/sys/class/hwmon/hwmon11/temp1_input"       # milliC -> /1e3 (edge)
S_K10TEMP="/sys/class/hwmon/hwmon7/temp1_input"            # milliC (CPU Tctl)
S_NVME_TEMP="/sys/class/hwmon/hwmon4/temp1_input"          # milliC
S_FAN_CPU="/sys/class/hwmon/hwmon8/fan1_input"             # RPM
S_FAN_GPU="/sys/class/hwmon/hwmon8/fan2_input"             # RPM
S_BAT_POWER="/sys/class/power_supply/BAT0/power_now"       # microWatts
# NOTE: acpitz temp3 is a stale/disconnected sensor — do not use.
